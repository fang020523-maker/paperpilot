# ============ PaperPilot 环境配置 ============
# 复制本文件为 .env.local 并填入真实密钥

# --- 智谱 AI（主生成模型，赛题推荐合作方）---
# 获取地址: https://open.bigmodel.cn/ → API Keys
# 支持多把密钥轮换：逗号分隔可显著降低单 key 触发平台限流(1314/1302)的概率
ZHIPU_API_KEY=

# --- DeepSeek（备用/故障转移模型）---
# 获取地址: https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY=

# --- 模型选择（可选，留空使用默认值）---
# 主生成模型（智谱）: glm-4.6 | glm-4.5 | glm-4-plus | glm-4-air | glm-4-flash(免费)
ZHIPU_CHAT_MODEL=glm-4.6
# Embedding 模型（智谱）: embedding-3
ZHIPU_EMBEDDING_MODEL=embedding-3
# DeepSeek 生成模型: deepseek-chat | deepseek-reasoner
DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- Embedding 策略 ---
# auto: 有智谱密钥走云端 embedding-3，否则本地 ONNX 端侧模型（e5-small，384维，零成本）
# cloud: 强制云端（需账户有 embedding-3 资源包，缺资源包时报 1113）
# local: 强制本地（免费可靠；演示机器推荐）
EMBEDDING_MODE=auto

# --- 批量导入提速开关（可选）---
# =1 时导入跳过 LLM 实体抽取、直接构建术语共现图谱：
# 15 篇论文从 ~40 分钟缩短到 ~3 分钟，且规避受限账号的高频风控。
# 正常（单篇/少量）导入时删掉本行以获得 LLM 精抽图谱与社区摘要。
# SKIP_EXTRACT=1
